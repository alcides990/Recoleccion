<!-- Created with Jaspersoft Studio version 6.20.6.final using JasperReports Library version 6.20.6-5c96b6aa8a39ac1dc6b6bea4b81168e16dd39231  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="comprobanteTicket" pageWidth="164" pageHeight="560" columnWidth="150" leftMargin="7" rightMargin="7" topMargin="8" bottomMargin="8" uuid="8d29fea6-b0fc-44c6-ae75-f85d6b1ddd33">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="recoleccion"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="codigoSucursal" class="java.lang.Integer"/>
	<parameter name="codigoPuntoExpedicion" class="java.lang.Integer"/>
	<parameter name="codigoTipoComprobante" class="java.lang.Integer"/>
	<parameter name="codigoSerie" class="java.lang.Integer"/>
	<parameter name="numeroComprobante" class="java.lang.Integer"/>
	<parameter name="montoLetras" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT COALESCE(e.razon_social, '') AS empresa,
       COALESCE(e.ruc, '') AS ruc,
       CONCAT(COALESCE(s.sucursal, ''),
              CASE WHEN ci.ciudad IS NULL OR ci.ciudad = '' THEN '' ELSE CONCAT(' - ', ci.ciudad) END) AS sucursal,
       COALESCE(s.direccion, '') AS direccion,
       COALESCE(NULLIF(NULLIF(TRIM(s.telefono), ''), '0'), NULLIF(NULLIF(TRIM(s.celular), ''), '0'), '') AS telefono,
       COALESCE(CAST(t.numero_timbrado AS CHAR), '') AS timbrado,
       COALESCE(DATE_FORMAT(t.fecha_inicio, '%d/%m/%Y'), '') AS inicioVigencia,
       COALESCE(tc.tipo_comprobante, '') AS tipoComprobante,
       CONCAT(LPAD(COALESCE(s.sucursal, c.codigo_sucursal), 3, '0'), '-',
              LPAD(COALESCE(pe.punto_expedicion, c.codigo_punto_expedicion), 3, '0'), '-',
              LPAD(c.numero_comprobante, 7, '0')) AS numeroDocumento,
       DATE_FORMAT(COALESCE(c.fecha_pago, c.fecha_emision), '%d/%m/%Y') AS fecha,
       COALESCE(c.razon_social, '') AS receptor,
       COALESCE(u.numero_documento, '') AS documento,
       COALESCE(c.cuenta_corriente, '') AS cuenta,
       COALESCE(cat.categoria, '') AS categoria,
       COALESCE(cv.condicion_venta, '') AS condicionVenta,
       CASE
         WHEN c.periodo_pago IS NULL OR c.periodo_pago = '' THEN ''
         WHEN TRIM(c.periodo_pago) REGEXP '^[0-9]{2}-[0-9]{4}([[:space:]]*/[[:space:]][0-9]{2}-[0-9]{4})?$'
           THEN REPLACE(TRIM(c.periodo_pago), ' / ', ' - ')
         WHEN c.periodo_pago LIKE '%/%' THEN CONCAT(
           DATE_FORMAT(STR_TO_DATE(SUBSTRING_INDEX(c.periodo_pago, '/', 1), '%Y-%m-%d'), '%m/%Y'),
           ' - ',
           DATE_FORMAT(STR_TO_DATE(SUBSTRING_INDEX(c.periodo_pago, '/', -1), '%Y-%m-%d'), '%m/%Y'))
         ELSE c.periodo_pago
       END AS periodo,
       COALESCE(CAST(c.cantidad_pago AS CHAR), '0') AS cantidad,
       FORMAT(COALESCE(c.tarifa, 0), 0, 'de_DE') AS tarifa,
       FORMAT(COALESCE(c.recargo, 0), 0, 'de_DE') AS recargo,
       FORMAT(COALESCE(c.total_importe, 0), 0, 'de_DE') AS total,
       FORMAT(COALESCE(c.total_importe, 0), 0, 'de_DE') AS gravada10,
       FORMAT(ROUND(COALESCE(c.total_importe, 0) / 11, 0), 0, 'de_DE') AS iva10,
       COALESCE((
         SELECT GROUP_CONCAT(CONCAT(COALESCE(mp.metodo_pago, ''), ': Gs. ', FORMAT(COALESCE(dp.importe, 0), 0, 'de_DE')) ORDER BY dp.codigo_metodo_pago SEPARATOR '\n')
           FROM detalle_pago dp
           LEFT JOIN metodos_pago mp ON mp.codigo_metodo_pago = dp.codigo_metodo_pago
          WHERE dp.codigo_sucursal = c.codigo_sucursal
            AND dp.codigo_punto_expedicion = c.codigo_punto_expedicion
            AND dp.codigo_tipo_comprobante = c.codigo_tipo_comprobante
            AND dp.codigo_serie = c.codigo_serie
            AND dp.numero_comprobante = c.numero_comprobante
       ), '') AS pagos,
       COALESCE(c.obs, '') AS observacion
  FROM comprobantes c
  JOIN sucursales s ON s.codigo_sucursal = c.codigo_sucursal
  JOIN empresas e ON e.codigo_empresa = s.codigo_empresa
  LEFT JOIN puntos_expedicion pe ON pe.codigo_sucursal = c.codigo_sucursal
                                AND pe.codigo_punto_expedicion = c.codigo_punto_expedicion
  LEFT JOIN ciudades ci ON ci.codigo_ciudad = s.codigo_ciudad
  LEFT JOIN timbrados t ON t.codigo_timbrado = c.codigo_timbrado
  LEFT JOIN tipos_comprobante tc ON tc.codigo_tipo_comprobante = c.codigo_tipo_comprobante
  LEFT JOIN usuarios u ON u.codigo_usuario = c.codigo_usuario
  LEFT JOIN categorias cat ON cat.codigo_categoria = c.codigo_categoria AND cat.codigo_sucursal = c.codigo_sucursal
  LEFT JOIN condiciones_venta cv ON cv.codigo_condicion_venta = c.codigo_condicion_venta
 WHERE c.codigo_sucursal = $P{codigoSucursal}
   AND c.codigo_punto_expedicion = $P{codigoPuntoExpedicion}
   AND c.codigo_tipo_comprobante = $P{codigoTipoComprobante}
   AND c.codigo_serie = $P{codigoSerie}
   AND c.numero_comprobante = $P{numeroComprobante}]]>
	</queryString>
