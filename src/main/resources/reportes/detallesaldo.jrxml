	<property name="ireport.y" value="0"/>
	<parameter name="area" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="zona" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="subzona" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="desde" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="hasta" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT  cob.Cobrador_Nombre AS cobra,dz.CodArea,dz.CodArea,dz.codZona,dz.Subzona,manzana, CuentaUsuario,nombre,Direccion,Categoria_idCategoria,cat.importe,
 cob.Cobrador_Nombre AS cobra,dz.CodArea,dz.CodArea,dz.codZona,dz.Subzona,manzana, nroruc AS UltiPago
,fn_meses_deuda(uso.CuentaUsuario,uso.Inicio,1,uso.Categoria_idCategoria)AS Cmes,
`fn_deuda`(uso.CuentaUsuario,uso.Inicio,1,uso.Categoria_idCategoria) AS Deuda,fn_ultimoPg(uso.CuentaUsuario) AS pagoUltimo,nroruc
FROM  detalle_zona dz
INNER JOIN usuario uso ON dz.manzana=uso.nromanzana
INNER JOIN categoria cat ON cat.idCategoria=uso.Categoria_idCategoria
INNER JOIN zonas zo ON dz.codArea=zo.CodArea AND dz.codZona=zo.codZona AND dz.SubZona=zo.SubZona 
INNER JOIN cobrador cob ON  cob.idCobrador=zo.Cobrador_idCobrador
and dz.codArea=$P{area} AND dz.codZona=$P{zona} AND dz.SubZona=$P{subzona}
 AND fn_meses_deuda(uso.CuentaUsuario,uso.Inicio,1,uso.Categoria_idCategoria)>=$P{desde}
AND fn_meses_deuda(uso.CuentaUsuario,uso.Inicio,1,uso.Categoria_idCategoria)<=$P{hasta}
ORDER BY CuentaUsuario,manzana ASC]]>
	</queryString>
