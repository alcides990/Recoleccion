<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="seguimientoCobrador" pageWidth="842" pageHeight="595" orientation="Landscape"
              whenNoDataType="NoPages" columnWidth="802" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20" uuid="73c8fb77-606e-44bd-b609-3ba9121f313d">
    <parameter name="desde" class="java.lang.String"/>
    <parameter name="hasta" class="java.lang.String"/>
    <parameter name="codigoSucursal" class="java.lang.Integer"/>
    <parameter name="codigoCobrador" class="java.lang.Integer"/>
    <parameter name="codigoSerie" class="java.lang.Integer"/>
    <parameter name="cobrador" class="java.lang.String"/>
    <queryString>
        <![CDATA[SELECT comp.numero_comprobante,
       comp.fecha_pago,
       comp.cuenta_corriente,
       COALESCE(NULLIF(TRIM(comp.razon_social), ''), CONCAT_WS(' ', usu.nombre, usu.apellido)) AS usuario,
       comp.total_importe AS importe,
       comp.cantidad_pago,
       ser.serie,
       CONCAT_WS(' ', cob.nombre, cob.apellido) AS nombre_cobrador
FROM comprobantes comp
JOIN usuarios usu ON usu.codigo_usuario = comp.codigo_usuario
JOIN cobradores cob ON cob.codigo_cobrador = comp.codigo_cobrador
JOIN series ser ON ser.codigo_serie = comp.codigo_serie
WHERE comp.codigo_sucursal = $P{codigoSucursal}
  AND comp.codigo_cobrador = $P{codigoCobrador}
  AND ($P{codigoSerie} = 0 OR comp.codigo_serie = $P{codigoSerie})
  AND comp.fecha_pago BETWEEN $P{desde} AND $P{hasta}
  AND comp.codigo_estado IN (1, 3)
ORDER BY comp.fecha_pago, comp.numero_comprobante]]>
    </queryString>
    <field name="numero_comprobante" class="java.lang.Integer"/>
    <field name="fecha_pago" class="java.sql.Date"/>
    <field name="cuenta_corriente" class="java.lang.String"/>
    <field name="usuario" class="java.lang.String"/>
    <field name="importe" class="java.lang.Double"/>
    <field name="cantidad_pago" class="java.lang.Integer"/>
    <field name="serie" class="java.lang.String"/>
    <field name="nombre_cobrador" class="java.lang.String"/>
    <variable name="totalImporte" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{importe} == null ? 0.0 : $F{importe}]]></variableExpression>
    </variable>
    <variable name="totalComprobantes" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{numero_comprobante}]]></variableExpression>
    </variable>
