	<property name="com.jaspersoft.studio.unit.columnSpacing" value="pixel"/>
	<parameter name="codigoSucursal" class="java.lang.Integer"/>
	<parameter name="codigoZona" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="codigoCobrador" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="desde" class="java.lang.Integer"/>
	<parameter name="hasta" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT servi.cuenta_corriente,  man.codigo_manzana,
fn_mes_deuda(servi.cuenta_corriente,$P{codigoSucursal}) AS mes_deuda,
fn_pagar_desde(servi.cuenta_corriente) AS pago_desde,
fn_ultimo_pago(servi.cuenta_corriente) AS ultimo_pago,
cate.categoria, cate.tarifa,
usu.numero_documento, usu.nombre, usu.apellido, usu.direccion, usu.celular,
cob.codigo_cobrador, CONCAT_WS('  ', cob.nombre,   cob.apellido) AS cobrador,
zon.codigo_zona, zon.zona

FROM servicios AS servi
JOIN manzanas AS man
  ON man.codigo_manzana=servi.codigo_manzana
  AND man.codigo_sucursal=servi.codigo_sucursal
  
INNER JOIN zonas AS zon
  ON zon.codigo_zona=man.codigo_zona
  AND zon.codigo_sucursal= man.codigo_sucursal
  
INNER JOIN cobradores AS cob
  ON cob.codigo_cobrador=zon.codigo_cobrador
  AND cob.codigo_sucursal=zon.codigo_sucursal
  
INNER JOIN categorias AS cate
  ON cate.codigo_categoria = servi.codigo_categoria
  AND cate.codigo_sucursal= servi.codigo_sucursal
INNER JOIN usuarios AS usu
  ON servi.codigo_usuario = usu.codigo_usuario
 WHERE cob.codigo_cobrador= $P{codigoCobrador} 
 AND servi.codigo_sucursal= $P{codigoSucursal}
 AND zon.codigo_zona= $P{codigoZona}
 HAVING mes_deuda BETWEEN $P{desde} AND $P{hasta}
 ORDER BY man.codigo_manzana, servi.cuenta_corriente]]>
	</queryString>
