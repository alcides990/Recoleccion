	<property name="com.jaspersoft.studio.report.description" value="Reporte de etado de cuentas por  zona"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="recoleccion"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.unit.topMargin" value="pixel"/>
