<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="IngresosPorZona" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="d4fa1245-b4fa-4dae-9cdf-bf63ad824fb7">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="recoleccion"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="195"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="800"/>
	<parameter name="desde" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="hasta" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT cob.codigo_cobrador, CONCAT(cob.nombre, ' ',cob.apellido) AS cobrador,
zon.zona, zon.codigo_zona,
COUNT( CASE comp.codigo_estado 
WHEN '2' THEN 1 END ) AS 'Fact. Anulada',

COUNT( CASE WHEN comp.codigo_tipo_factura = 2 AND comp.codigo_estado = 1
  THEN 1 END ) AS 'Fact. Manual',
  
  COUNT( CASE WHEN comp.codigo_tipo_factura = 1 AND comp.codigo_estado = 1
  THEN 1 END ) AS 'Fact. Impresa',

SUM(comp.total_importe) AS importe, SUM(dtc.recargo) AS recargo
FROM comprobantes AS comp
JOIN detalle_comprobantes AS dtc
  ON dtc.codigo_sucursal = comp.codigo_sucursal
    AND dtc.codigo_punto_expedicion = comp.codigo_punto_expedicion
    AND dtc.numero_comprobante = comp.numero_comprobante
    AND dtc.codigo_tipo_factura = comp.codigo_tipo_factura
LEFT JOIN servicios AS servi 
  ON comp.`cuenta_corriente`= servi.`cuenta_corriente`

LEFT JOIN manzanas AS man
  ON man.codigo_manzana=servi.codigo_manzana
  AND man.codigo_sucursal=comp.codigo_sucursal
LEFT JOIN zonas AS zon
  ON zon.`codigo_zona`=man.`codigo_zona`
LEFT JOIN cobradores AS cob 
  ON cob.`codigo_cobrador` = comp.`codigo_cobrador`

 WHERE	 comp.`codigo_estado`=1 
  AND comp.fecha_pago >= $P{desde} 
  AND comp.fecha_pago <= $P{hasta} 
  
GROUP BY zon.`codigo_zona`]]>
	</queryString>
