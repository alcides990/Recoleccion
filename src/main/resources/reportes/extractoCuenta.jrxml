	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="recoleccion"/>
	<parameter name="cuentaCorriente" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="cantidadRegistro" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="codigoSucursal" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT c.`numero_comprobante`, c.`cuenta_corriente`, c.`cantidad_pago`, c.`fecha_pago`,  c.`razon_social`, c.`total_importe`,
 s.direccion, dtc.`periodo_pago`, cate.categoria, cate.tarifa,
 fn_pago_hasta($P{cuentaCorriente}) AS pago_hasta, fn_mes_deuda($P{cuentaCorriente}, $P{codigoSucursal}  ) AS cantidad_deuda,
 fn_recargo($P{cuentaCorriente}, $P{codigoSucursal} ) AS recargo
 FROM comprobantes c
JOIN servicios AS s
  ON s.cuenta_corriente= c.cuenta_corriente
JOIN detalle_comprobantes AS dtc
  ON dtc.`numero_comprobante`=c.`numero_comprobante`
   AND dtc.`codigo_punto_expedicion`=c.`codigo_punto_expedicion`
   AND dtc.`codigo_tipo_factura`=c.`codigo_tipo_factura`
   AND dtc.`codigo_serie`=c.`codigo_serie`
   AND dtc.`codigo_sucursal`=c.`codigo_sucursal` 
 JOIN categorias cate
   ON cate.codigo_categoria=s.codigo_categoria
WHERE c.cuenta_corriente=$P{cuentaCorriente}
ORDER BY c.fecha_pago DESC 
LIMIT  $P{cantidadRegistro}]]>
	</queryString>
