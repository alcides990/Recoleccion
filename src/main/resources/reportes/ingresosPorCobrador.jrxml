	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="recoleccion"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="266"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="729"/>
	<parameter name="desde" class="java.lang.String" nestedType="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="hasta" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="codigoSucursal" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT cob.codigo_cobrador, concat_ws(' ', cob.nombre, cob.apellido) AS cobrador,

COUNT( CASE WHEN  comp.codigo_estado = 3 THEN 1 END ) AS 'Fact. Anulada',

COUNT( CASE WHEN comp.codigo_tipo_comprobante = 1 AND comp.codigo_estado = 1
  THEN 1 END ) AS 'Fact. Manual',
  
  COUNT( CASE WHEN comp.codigo_tipo_comprobante = 2 AND comp.codigo_estado = 1
  THEN 1 END ) AS 'Fact. Electronica',

SUM(CASE WHEN comp.codigo_estado = 1 THEN comp.total_importe END) AS importe

FROM comprobantes AS comp
JOIN cobradores AS  cob
  ON cob.codigo_cobrador = comp.codigo_cobrador
 AND cob.codigo_sucursal = comp.codigo_sucursal
 WHERE	 comp.fecha_pago BETWEEN $P{desde}  AND  $P{hasta} 
   AND comp.codigo_sucursal = $P{codigoSucursal}
  
GROUP BY cob.codigo_sucursal, cob.codigo_cobrador, cob.nombre, cob.apellido
ORDER BY  cob.codigo_cobrador ASC]]>
	</queryString>
