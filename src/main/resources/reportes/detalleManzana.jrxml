	<parameter name="codigoZona" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="codigoCobrador" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="desde" class="java.lang.Integer"/>
	<parameter name="hasta" class="java.lang.Integer"/>
	<parameter name="manzana" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT servi.cuenta_corriente, servi.`manzana`,
fn_mes_deuda(servi.cuenta_corriente) AS mes_deuda, 
fn_pago_hasta(servi.cuenta_corriente) AS pago_hasta,
fn_ultimo_pago(servi.cuenta_corriente) AS ultimo_pago,
cate.`categoria`, cate.`tarifa`,
usu.numero_documento, usu.`nombre`, usu.`apellido`, usu.`direccion`,
cob.codigo_cobrador, CONCAT(cob.nombre, ' ', cob.apellido) AS cobrador,
zon.codigo_zona, zon.zona
FROM detallezonas AS dtz
INNER JOIN zonas AS zon
  ON zon.codigo_zona=dtz.`codigo_zona`
  AND zon.codigo_sucursal= dtz.`codigo_sucursal`
INNER JOIN servicios AS servi
  ON servi.`codigo_sucursal`=dtz.`codigo_sucursal`
  AND servi.`manzana`=dtz.`manzana`
INNER JOIN cobradores AS cob
  ON cob.`codigo_cobrador`=dtz.`codigo_cobrador`
  AND cob.`codigo_sucursal`=dtz.`codigo_sucursal`
INNER JOIN categorias AS cate
  ON cate.`codigo_categoria` = servi.`codigo_categoria` 
  AND cate.`codigo_sucursal`= servi.`codigo_sucursal`
INNER JOIN usuarios AS usu
  ON servi.codigo_usuario = usu.codigo_usuario
 WHERE cob.codigo_cobrador= $P{codigoCobrador} 
 AND zon.codigo_zona= $P{codigoZona}
  AND dtz.manzana= $P{manzana}
 AND fn_mes_deuda(servi.cuenta_corriente)>= $P{desde} 
 AND fn_mes_deuda(servi.cuenta_corriente)  <= $P{hasta}]]>
	</queryString>
