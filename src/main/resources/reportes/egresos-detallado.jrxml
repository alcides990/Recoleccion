<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="egresos-detallado" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30">
<style name="base" isDefault="true" fontName="DejaVu Sans" fontSize="9"/><parameter name="periodo" class="java.lang.String"/><parameter name="sucursal" class="java.lang.String"/><parameter name="titulo" class="java.lang.String"/><field name="id" class="java.lang.Long"/><field name="fecha" class="java.util.Date"/><field name="tipo" class="java.lang.String"/><field name="proveedor" class="java.lang.String"/><field name="producto" class="java.lang.String"/><field name="cantidad" class="java.math.BigDecimal"/><field name="precio" class="java.math.BigDecimal"/><field name="subtotal" class="java.math.BigDecimal"/><variable name="total" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{subtotal}]]></variableExpression></variable>
<group name="gasto"><groupExpression><![CDATA[$F{id}]]></groupExpression><groupHeader><band height="46"><textField><reportElement x="0" y="0" width="535" height="19" mode="Opaque" backcolor="#E9EEF3"/><textElement><font isBold="true"/></textElement><textFieldExpression><![CDATA["Gasto #" + $F{id} + " | " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{fecha}) + " | " + $F{tipo}]]></textFieldExpression></textField><textField><reportElement x="0" y="23" width="535" height="18"/><textFieldExpression><![CDATA["Proveedor: " + $F{proveedor}]]></textFieldExpression></textField></band></groupHeader></group>
<title><band height="65"><textField><reportElement x="0" y="0" width="535" height="25"/><textElement><font size="17" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{titulo}]]></textFieldExpression></textField><textField><reportElement x="0" y="30" width="535" height="18"/><textFieldExpression><![CDATA["Sucursal: " + $P{sucursal} + " | Período: " + $P{periodo}]]></textFieldExpression></textField></band></title>
<columnHeader><band height="22"><staticText><reportElement x="0" y="0" width="250" height="20" mode="Opaque" backcolor="#E9EEF3"/><text><![CDATA[Producto/Servicio]]></text></staticText><staticText><reportElement x="250" y="0" width="80" height="20" mode="Opaque" backcolor="#E9EEF3"/><text><![CDATA[Cantidad]]></text></staticText><staticText><reportElement x="330" y="0" width="95" height="20" mode="Opaque" backcolor="#E9EEF3"/><text><![CDATA[Precio]]></text></staticText><staticText><reportElement x="425" y="0" width="110" height="20" mode="Opaque" backcolor="#E9EEF3"/><text><![CDATA[Subtotal]]></text></staticText></band></columnHeader>
<detail><band height="20"><textField><reportElement x="0" y="1" width="250" height="18"/><textFieldExpression><![CDATA[$F{producto}]]></textFieldExpression></textField><textField pattern="#,##0.###"><reportElement x="250" y="1" width="80" height="18"/><textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression></textField><textField pattern="#,##0.00"><reportElement x="330" y="1" width="95" height="18"/><textFieldExpression><![CDATA[$F{precio}]]></textFieldExpression></textField><textField pattern="#,##0.00"><reportElement x="425" y="1" width="110" height="18"/><textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression></textField></band></detail>
<summary><band height="28"><textField pattern="#,##0.00"><reportElement x="390" y="4" width="145" height="20"/><textElement textAlignment="Right"><font isBold="true"/></textElement><textFieldExpression><![CDATA[$V{total}]]></textFieldExpression></textField></band></summary>
</jasperReport>
